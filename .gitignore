# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
.gradle-home/
build/
!gradle/wrapper/gradle-wrapper.jar

# ── Java ──────────────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
hs_err_pid*

# ── IDE / editor ──────────────────────────────────────────────────────────────
# .idea は丸ごと無視せず、共有すべきプロジェクト設定だけ追跡する。
# 個人固有ファイル (workspace.xml など) は .idea/.gitignore 側で除外済み。
.idea/*
!.idea/gradle.xml
!.idea/misc.xml
!.idea/vcs.xml
!.idea/.gitignore
*.iml
.vscode/
*.swp
*~

# ── Nix ───────────────────────────────────────────────────────────────────────
result
result-*
.direnv/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
